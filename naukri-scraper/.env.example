# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Job Tracker backend. Point at your deployed Render URL.
BACKEND_URL=https://job-tracker-g8bx.onrender.com
APP_USERNAME=admin
APP_PASSWORD=

# Auto-apply (runs only when the local apply-bot is up: `npm run serve` in apply-bot/)
# NAUKRI_AUTO_APPLY=1   # force on; 0 force off; unset = detect http://127.0.0.1:5055/health
# NAUKRI_DAILY_CAP=40
# NAUKRI_RECORD_BACKEND=1
# Chatbot answers: see apply-bot/naukri-answers.example.json (copy to naukri-answers.json)
