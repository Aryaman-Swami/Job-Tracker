# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Job Tracker backend (Spring Boot). Point this at your deployed Render URL
# so apply-bot fetches real job/resume data even though it runs locally
# (e.g. https://job-tracker-g8bx.onrender.com). Use http://localhost:3000
# only if you're also running the backend locally.
BACKEND_URL=https://job-tracker-g8bx.onrender.com
APP_USERNAME=admin
APP_PASSWORD=

# Local helper server (server.js) — the Auto-Apply button in the frontend
# (Netlify or local) calls this directly from your browser at
# http://127.0.0.1:APPLY_BOT_PORT. It only binds to 127.0.0.1, never your
# network, and only accepts requests from these origins.
APPLY_BOT_PORT=5055
ALLOWED_ORIGINS=http://localhost:5173,https://your-site.netlify.app

# Candidate account credentials to use/create on Workday tenants ONLY.
# Workday requires a SEPARATE account per company's Workday site (there is no
# single global Workday login) — the bot reuses this same email/password to
# sign up on each new tenant it encounters, and logs in with them afterwards.
# Naukri/LinkedIn/Indeed/Wellfound are NOT here on purpose: those platforms
# actively detect and can suspend automated logins, so the bot pauses and
# asks you to log into those by hand instead (session cookies get reused
# after that, same as Workday).
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# Used to fill guest-application forms (Greenhouse, Lever) and any
# unrecognized company career page (the generic fallback adapter).
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
