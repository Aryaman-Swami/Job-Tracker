# Copy to scraper/local.env (gitignored) and fill in. Used by run_hiringcafe_local.ps1
# so the locally started backend writes to Supabase instead of local Postgres.
# Supabase dashboard -> Project Settings -> Database -> Connection Pooler
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require
APP_USERNAME=admin
APP_PASSWORD=admin
