{
  "manifest_version": 3,
  "name": "Job Tracker Auto-Apply",
  "version": "0.1.0",
  "description": "Pulls to_ask jobs from your Job Tracker backend and applies on Greenhouse, Lever, Ashby and Workday with your tailored resume.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://job-tracker-g8bx.onrender.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.myworkdayjobs.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.myworkdayjobs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Auto-Apply" },
  "options_page": "options.html"
}
